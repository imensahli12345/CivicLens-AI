# Database - same PostgreSQL as .NET backend
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/civiclens_db

# App
APP_HOST=0.0.0.0
APP_PORT=8002
CORS_ORIGINS=["http://localhost:3000","http://localhost:4200","http://localhost:8080","http://localhost:8085","http://127.0.0.1:8085"]

# Redis (optional - disable if not available)
REDIS_URL=redis://localhost:6379
USE_REDIS=false
